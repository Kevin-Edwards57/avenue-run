# Realtime multiplayer server (Cloudflare Worker + Durable Objects).
# Leave unset for local development — the client defaults to ws://localhost:8787
# (run `npm run multiplayer:dev`).
#
# For production, set this to your deployed Worker's URL (wss://...):
#   VITE_MULTIPLAYER_URL=wss://avenue-run-mp.<your-subdomain>.workers.dev
#
# Single-player never uses this; it is only read when a player opens 2-Player.
VITE_MULTIPLAYER_URL=
